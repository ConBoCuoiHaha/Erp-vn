    <record id="rule_discipline_company" model="ir.rule">
        <field name="name">Kỷ luật theo công ty được phép</field>
        <field name="model_id" ref="model_lfood_hr_discipline"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_reward_company" model="ir.rule">
        <field name="name">Khen thưởng theo công ty được phép</field>
        <field name="model_id" ref="model_lfood_hr_reward"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
