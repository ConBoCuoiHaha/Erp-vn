<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_kpi_period_company" model="ir.rule">
        <field name="name">Kỳ đánh giá theo công ty được phép</field>
        <field name="model_id" ref="model_lfood_kpi_period"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_training_course_company" model="ir.rule">
        <field name="name">Khóa đào tạo theo công ty được phép</field>
        <field name="model_id" ref="model_lfood_training_course"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="view_kpi_period_list" model="ir.ui.view">
        <field name="name">lfood.kpi.period.list</field>
        <field name="model">lfood.kpi.period</field>
        <field name="arch" type="xml">
            <list string="Kỳ đánh giá hiệu suất">
                <field name="name"/><field name="date_from"/><field name="date_to"/><field name="bonus_base"/><field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_kpi_period_form" model="ir.ui.view">
        <field name="name">lfood.kpi.period.form</field>
        <field name="model">lfood.kpi.period</field>
        <field name="arch" type="xml">
            <form string="Kỳ đánh giá hiệu suất">
                <header>
                    <button name="action_approve" type="object" string="Duyệt, tạo quyết định thưởng" class="btn-primary"
                            invisible="state != 'draft'" groups="lfood_base.group_director"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group><field name="name" readonly="state != 'draft'"/><field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="state != 'draft'"/><field name="bonus_base" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/></group>
                        <group><field name="coef_a" readonly="state != 'draft'"/><field name="coef_b" readonly="state != 'draft'"/>
                            <field name="coef_c" readonly="state != 'draft'"/><field name="coef_d" readonly="state != 'draft'"/>
                            <field name="approved_by"/></group>
                    </group>
                    <field name="review_ids" readonly="state != 'draft'">
                        <list><field name="employee_id"/><field name="score"/><field name="rating"/><field name="bonus" sum="Tổng"/>
                            <field name="reward_id"/></list>
                        <form>
                            <group><field name="employee_id"/><field name="score"/><field name="rating"/><field name="bonus"/></group>
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="name"/><field name="weight" sum="Tổng"/><field name="target"/><field name="actual"/>
                                    <field name="lower_better"/><field name="achievement"/>
                                </list>
                            </field>
                            <field name="comment" placeholder="Nhận xét của quản lý"/>
                        </form>
                    </field>
                    <div class="text-muted">Điểm chỉ tiêu = thực hiện / mục tiêu (tối đa 120%); xếp loại A từ 100, B từ 85, C từ 70 điểm. Thưởng = mức cơ
                        sở x hệ số; duyệt thì tạo quyết định khen thưởng, tự vào bảng lương tháng của ngày cuối kỳ.</div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_kpi_period" model="ir.actions.act_window">
        <field name="name">Đánh giá hiệu suất</field>
        <field name="res_model">lfood.kpi.period</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_training_course_list" model="ir.ui.view">
        <field name="name">lfood.training.course.list</field>
        <field name="model">lfood.training.course</field>
        <field name="arch" type="xml">
            <list string="Đào tạo">
                <field name="name"/><field name="kind"/><field name="provider"/><field name="date_start"/>
                <field name="hours"/><field name="cost" sum="Tổng"/><field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_training_course_form" model="ir.ui.view">
        <field name="name">lfood.training.course.form</field>
        <field name="model">lfood.training.course</field>
        <field name="arch" type="xml">
            <form string="Khóa đào tạo">
                <header>
                    <button name="action_done" type="object" string="Đã học xong" class="btn-primary" invisible="state != 'planned'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group><field name="name"/><field name="kind"/><field name="provider"/><field name="date_start"/></group>
                        <group><field name="hours"/><field name="cost"/><field name="cost_per_head"/><field name="valid_months"/>
                            <field name="company_id" groups="base.group_multi_company"/></group>
                    </group>
                    <field name="attendee_ids">
                        <list editable="bottom">
                            <field name="employee_id" options="{'no_create': True}"/><field name="result"/>
                            <field name="certificate_no"/><field name="expiry"/>
                            <field name="certificate" filename="certificate_name"/><field name="certificate_name" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_training_course" model="ir.actions.act_window">
        <field name="name">Đào tạo</field>
        <field name="res_model">lfood.training.course</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_kpi_period" name="Đánh giá hiệu suất" parent="lfood_hr.menu_hr_root" action="action_kpi_period" sequence="50"/>
    <menuitem id="menu_training_course" name="Đào tạo" parent="lfood_hr.menu_hr_root" action="action_training_course" sequence="55"/>
</odoo>
