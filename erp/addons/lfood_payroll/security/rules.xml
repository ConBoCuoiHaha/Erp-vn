<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_employee_company" model="ir.rule">
        <field name="name">Nhân viên theo công ty được phép</field>
        <field name="model_id" ref="model_lfood_employee"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_run_company" model="ir.rule">
        <field name="name">Bảng lương theo công ty được phép</field>
        <field name="model_id" ref="model_lfood_payroll_run"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_slip_company" model="ir.rule">
        <field name="name">Phiếu lương theo công ty được phép</field>
        <field name="model_id" ref="model_lfood_payroll_slip"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
