<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_document_list" model="ir.ui.view">
        <field name="name">lfood.document.list</field>
        <field name="model">lfood.document</field>
        <field name="arch" type="xml">
            <list string="Hồ sơ lưu trữ">
                <field name="doc_date"/>
                <field name="doc_type"/>
                <field name="name"/>
                <field name="ref"/>
                <field name="res_ref" optional="show"/>
                <field name="retain_until"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_document_search" model="ir.ui.view">
        <field name="name">lfood.document.search</field>
        <field name="model">lfood.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="ref"/>
                <field name="file_name"/>
                <filter name="expired" string="Đã hết hạn lưu trữ" domain="[('retain_until', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="by_type" string="Loại" context="{'group_by': 'doc_type'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_document_form" model="ir.ui.view">
        <field name="name">lfood.document.form</field>
        <field name="model">lfood.document</field>
        <field name="arch" type="xml">
            <form string="Hồ sơ lưu trữ">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="doc_type"/>
                            <field name="doc_date"/>
                            <field name="ref"/>
                            <field name="res_ref"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="file" filename="file_name" readonly="id"/>
                            <field name="file_name" invisible="1"/>
                            <field name="policy_id" options="{'no_create': True}"/>
                            <field name="retain_until"/>
                            <field name="checksum"/>
                            <field name="intact" invisible="not id"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Ghi chú"/>
                    <div class="text-muted">Luật Kế toán 2015 và Nghị định 174/2016/NĐ-CP: chứng từ dùng trực tiếp ghi sổ lưu tối
                        thiểu 10 năm, tài liệu khác 5 năm, tính từ hết năm tài chính. Tệp không thay được; hồ sơ không xóa được
                        trước hạn; mã SHA-256 dùng để kiểm tra tệp còn nguyên vẹn.</div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_document" model="ir.actions.act_window">
        <field name="name">Hồ sơ lưu trữ</field>
        <field name="res_model">lfood.document</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_archive_policy_list" model="ir.ui.view">
        <field name="name">lfood.archive.policy.list</field>
        <field name="model">lfood.archive.policy</field>
        <field name="arch" type="xml">
            <list string="Thời hạn lưu trữ" editable="bottom">
                <field name="name"/>
                <field name="years"/>
                <field name="legal_ref"/>
            </list>
        </field>
    </record>
    <record id="action_archive_policy" model="ir.actions.act_window">
        <field name="name">Thời hạn lưu trữ</field>
        <field name="res_model">lfood.archive.policy</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem id="menu_document" name="Hồ sơ lưu trữ" parent="lfood_base.menu_documents" action="action_document" sequence="90"/>
    <menuitem id="menu_archive_policy" name="Thời hạn lưu trữ" parent="lfood_base.menu_config" action="action_archive_policy" sequence="96"/>
</odoo>
