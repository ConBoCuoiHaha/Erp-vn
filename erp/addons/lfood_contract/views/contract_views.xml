<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_contract_list" model="ir.ui.view">
        <field name="name">lfood.purchase.contract.list</field>
        <field name="model">lfood.purchase.contract</field>
        <field name="arch" type="xml">
            <list string="Hợp đồng mua khung">
                <field name="name"/><field name="partner_id"/><field name="contract_ref"/>
                <field name="date_from"/><field name="date_to"/><field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_purchase_contract_form" model="ir.ui.view">
        <field name="name">lfood.purchase.contract.form</field>
        <field name="model">lfood.purchase.contract</field>
        <field name="arch" type="xml">
            <form string="Hợp đồng mua khung">
                <header>
                    <button name="action_activate" type="object" string="Hiệu lực" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close" type="object" string="Thanh lý" invisible="state != 'active'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="contract_ref" readonly="state != 'draft'"/>
                            <field name="document" filename="document_name"/>
                            <field name="document_name" invisible="1"/>
                        </group>
                        <group>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="product_id" options="{'no_create': True}"/>
                            <field name="price"/>
                            <field name="qty_committed"/>
                            <field name="qty_ordered"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_purchase_contract" model="ir.actions.act_window">
        <field name="name">Hợp đồng mua khung</field>
        <field name="res_model">lfood.purchase.contract</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_supplier_eval_list" model="ir.ui.view">
        <field name="name">lfood.supplier.evaluation.list</field>
        <field name="model">lfood.supplier.evaluation</field>
        <field name="arch" type="xml">
            <list string="Đánh giá nhà cung cấp" decoration-danger="result == 'rejected'">
                <field name="name"/><field name="partner_id"/><field name="date_to"/>
                <field name="score"/><field name="result"/><field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_supplier_eval_form" model="ir.ui.view">
        <field name="name">lfood.supplier.evaluation.form</field>
        <field name="model">lfood.supplier.evaluation</field>
        <field name="arch" type="xml">
            <form string="Đánh giá nhà cung cấp">
                <header>
                    <button name="action_compute" type="object" string="Lấy số liệu" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Kết luận" class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="state != 'draft'"/>
                            <field name="orders"/>
                            <field name="on_time_rate"/>
                            <field name="quality_rate"/>
                            <field name="price_score" readonly="state != 'draft'"/>
                            <field name="service_score" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="weight_delivery" readonly="state != 'draft'"/>
                            <field name="weight_quality" readonly="state != 'draft'"/>
                            <field name="weight_price" readonly="state != 'draft'"/>
                            <field name="weight_service" readonly="state != 'draft'"/>
                            <field name="score"/>
                            <field name="result"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Nhận xét, yêu cầu khắc phục" readonly="state != 'draft'"/>
                    <div class="text-muted">Từ 80 điểm: chấp thuận; 60-79: chấp thuận có điều kiện; dưới 60: loại, không đặt hàng
                        được. Tỷ lệ giao đúng hạn so với ngày giao dự kiến của đơn mua; tỷ lệ chất lượng từ phiếu kiểm tra chất lượng.</div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_supplier_eval" model="ir.actions.act_window">
        <field name="name">Đánh giá nhà cung cấp</field>
        <field name="res_model">lfood.supplier.evaluation</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_distributor_list" model="ir.ui.view">
        <field name="name">lfood.distributor.contract.list</field>
        <field name="model">lfood.distributor.contract</field>
        <field name="arch" type="xml">
            <list string="Hợp đồng nhà phân phối">
                <field name="name"/><field name="partner_id"/><field name="date_from"/><field name="date_to"/>
                <field name="revenue"/><field name="rebate"/><field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_distributor_form" model="ir.ui.view">
        <field name="name">lfood.distributor.contract.form</field>
        <field name="model">lfood.distributor.contract</field>
        <field name="arch" type="xml">
            <form string="Hợp đồng nhà phân phối">
                <header>
                    <button name="action_activate" type="object" string="Thực hiện" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_compute" type="object" string="Tính doanh số" invisible="state != 'active'"/>
                    <button name="action_settle" type="object" string="Quyết toán thưởng" class="btn-primary" invisible="state != 'active'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="contract_ref" readonly="state != 'draft'"/>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="revenue"/><field name="rate"/><field name="rebate"/><field name="refund_id"/>
                        </group>
                    </group>
                    <field name="tier_ids" readonly="state != 'draft'">
                        <list editable="bottom"><field name="threshold"/><field name="rate"/></list>
                    </field>
                    <div class="text-muted">Thưởng doanh số là chiết khấu thương mại: lập hóa đơn điều chỉnh giảm (Thông tư 91/2026/TT-BTC Điều 10),
                        ghi Nợ 521, 33311 / Có 131 (Thông tư 99/2025/TT-BTC), tách theo thuế suất của hàng đã bán.</div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_distributor" model="ir.actions.act_window">
        <field name="name">Hợp đồng nhà phân phối</field>
        <field name="res_model">lfood.distributor.contract</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_trade_program_list" model="ir.ui.view">
        <field name="name">lfood.trade.program.list</field>
        <field name="model">lfood.trade.program</field>
        <field name="arch" type="xml">
            <list string="Trade marketing, trưng bày">
                <field name="name"/><field name="channel_id"/><field name="partner_id"/><field name="cost_item_id"/>
                <field name="date_from"/><field name="date_to"/><field name="budget" sum="Ngân sách"/>
                <field name="spent"/><field name="remaining"/>
            </list>
        </field>
    </record>
    <record id="view_trade_program_form" model="ir.ui.view">
        <field name="name">lfood.trade.program.form</field>
        <field name="model">lfood.trade.program</field>
        <field name="arch" type="xml">
            <form string="Chương trình trade marketing">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/><field name="channel_id"/><field name="partner_id"/>
                            <field name="cost_item_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="date_from"/><field name="date_to"/><field name="budget"/>
                            <field name="spent"/><field name="remaining"/>
                        </group>
                    </group>
                    <field name="payment_ids" readonly="1">
                        <list><field name="name"/><field name="date"/><field name="memo"/><field name="amount"/><field name="state"/></list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_trade_program" model="ir.actions.act_window">
        <field name="name">Trade marketing, trưng bày</field>
        <field name="res_model">lfood.trade.program</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_purchase_order_form_contract" model="ir.ui.view">
        <field name="name">lfood.purchase.order.form.contract</field>
        <field name="model">lfood.purchase.order</field>
        <field name="inherit_id" ref="lfood_purchase.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="contract_id" options="{'no_create': True}" readonly="state != 'draft'"/>
            </xpath>
        </field>
    </record>
    <record id="view_payment_form_trade" model="ir.ui.view">
        <field name="name">lfood.payment.form.trade</field>
        <field name="model">lfood.payment</field>
        <field name="inherit_id" ref="lfood_ledger.view_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='purpose']" position="after">
                <field name="trade_program_id" invisible="kind != 'out'" readonly="state != 'draft'" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
    <record id="view_partner_form_supplier_status" model="ir.ui.view">
        <field name="name">res.partner.lfood.form.supplier.status</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="lfood_admin.view_partner_lfood_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='comment']/.." position="before">
                <group string="Nhà cung cấp"><field name="lfood_supplier_status"/></group>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_purchase_contract" name="Hợp đồng mua khung" parent="lfood_purchase.menu_purchase_root" action="action_purchase_contract" sequence="25"/>
    <menuitem id="menu_supplier_eval" name="Đánh giá nhà cung cấp" parent="lfood_purchase.menu_purchase_root" action="action_supplier_eval" sequence="60"/>
    <menuitem id="menu_distributor" name="Hợp đồng nhà phân phối" parent="lfood_sale.menu_sale_root" action="action_distributor" sequence="35"/>
    <menuitem id="menu_trade_program" name="Trade marketing, trưng bày" parent="lfood_sale.menu_sale_root" action="action_trade_program" sequence="36"/>
</odoo>
