<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_purchase_contract_company" model="ir.rule">
        <field name="name">Hợp đồng mua khung theo công ty được phép</field>
        <field name="model_id" ref="model_lfood_purchase_contract"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_supplier_evaluation_company" model="ir.rule">
        <field name="name">Đánh giá nhà cung cấp theo công ty được phép</field>
        <field name="model_id" ref="model_lfood_supplier_evaluation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_distributor_contract_company" model="ir.rule">
        <field name="name">Hợp đồng nhà phân phối theo công ty được phép</field>
        <field name="model_id" ref="model_lfood_distributor_contract"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_trade_program_company" model="ir.rule">
        <field name="name">Chương trình trade marketing theo công ty được phép</field>
        <field name="model_id" ref="model_lfood_trade_program"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
