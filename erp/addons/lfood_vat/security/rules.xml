<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_vat_return_company" model="ir.rule">
        <field name="name">Tờ khai thuế theo công ty được phép</field>
        <field name="model_id" ref="model_lfood_vat_return"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_vat_line_company" model="ir.rule">
        <field name="name">Bảng kê theo công ty được phép</field>
        <field name="model_id" ref="model_lfood_vat_return_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_einvoice_check_company" model="ir.rule">
        <field name="name">Đối chiếu hóa đơn theo công ty được phép</field>
        <field name="model_id" ref="model_lfood_einvoice_check"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
