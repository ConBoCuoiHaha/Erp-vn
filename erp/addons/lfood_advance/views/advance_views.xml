<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_advance_list" model="ir.ui.view">
        <field name="name">lfood.advance.list</field>
        <field name="model">lfood.advance</field>
        <field name="arch" type="xml">
            <list string="Tạm ứng" decoration-danger="state in ('approved', 'paid') and due_date &lt; current_date">
                <field name="name"/>
                <field name="date"/>
                <field name="employee_id"/>
                <field name="reason"/>
                <field name="amount" sum="Đề nghị"/>
                <field name="due_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_advance_search" model="ir.ui.view">
        <field name="name">lfood.advance.search</field>
        <field name="model">lfood.advance</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <filter name="open" string="Chưa hoàn tất" domain="[('state', 'in', ('draft', 'approved', 'paid', 'settled'))]"/>
                <filter name="overdue" string="Quá hạn chưa thanh toán"
                        domain="[('state', 'in', ('approved', 'paid')), ('due_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="by_employee" string="Người tạm ứng" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_advance_form" model="ir.ui.view">
        <field name="name">lfood.advance.form</field>
        <field name="model">lfood.advance</field>
        <field name="arch" type="xml">
            <form string="Tạm ứng">
                <header>
                    <button name="action_approve" type="object" string="Duyệt" class="btn-primary" invisible="state != 'draft'"
                            groups="lfood_base.group_chief_accountant,lfood_base.group_director"/>
                    <button name="action_refuse" type="object" string="Từ chối" invisible="state != 'draft'"
                            groups="lfood_base.group_chief_accountant,lfood_base.group_director"/>
                    <button name="action_pay" type="object" string="Lập phiếu chi tạm ứng" class="btn-primary"
                            invisible="state != 'approved'" groups="lfood_base.group_accountant"/>
                    <button name="action_settle" type="object" string="Ghi sổ thanh toán tạm ứng" class="btn-primary"
                            invisible="state != 'paid'" groups="lfood_base.group_accountant"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,paid,settled,closed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Giấy đề nghị tạm ứng">
                            <field name="employee_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="reason" readonly="state != 'draft'"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="due_date" readonly="state != 'draft'"/>
                            <field name="method" readonly="state != 'draft'"/>
                            <field name="approved_by" invisible="not approved_by"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                        </group>
                        <group string="Tình hình thanh toán">
                            <field name="paid"/>
                            <field name="spent"/>
                            <field name="returned"/>
                            <field name="remaining"/>
                            <field name="settle_date" readonly="state != 'paid'"/>
                            <field name="salary_deduct" readonly="state != 'paid'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Bảng thanh toán tạm ứng">
                            <field name="line_ids" readonly="state != 'paid'">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="account"/>
                                    <field name="cost_item_id" options="{'no_create': True}"/>
                                    <field name="invoice_ref"/>
                                    <field name="seller_id" options="{'no_create': True}"/>
                                    <field name="amount" sum="Chưa thuế"/>
                                    <field name="vat_rate_id" options="{'no_create': True}"/>
                                    <field name="tax" sum="Thuế"/>
                                    <field name="total" sum="Tổng"/>
                                    <field name="pay_method"/>
                                </list>
                            </field>
                        </page>
                        <page string="Phiếu thu, chi">
                            <field name="payment_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="kind"/>
                                    <field name="method"/>
                                    <field name="amount"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <div class="text-muted">
                        Tài khoản 141 theo Thông tư 99/2025/TT-BTC: theo dõi từng lần tạm ứng của từng người; thanh toán tạm ứng theo
                        chứng từ gốc đã duyệt; chi không hết thì nộp lại quỹ hoặc trừ lương, chi quá thì chi bổ sung. Hóa đơn từ ngưỡng
                        thanh toán không dùng tiền mặt mà người tạm ứng trả tiền mặt thì không được khấu trừ thuế GTGT.
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_advance" model="ir.actions.act_window">
        <field name="name">Tạm ứng</field>
        <field name="res_model">lfood.advance</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
    <menuitem id="menu_advance" name="Tạm ứng, hoàn ứng" parent="lfood_ledger.menu_ledger_root" action="action_advance" sequence="12"/>

    <record id="view_company_form_advance" model="ir.ui.view">
        <field name="name">res.company.lfood.form.advance</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="lfood_base.view_company_lfood_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lfood_edit_after_post_days']" position="after">
                <field name="lfood_advance_block_overdue"/>
            </xpath>
        </field>
    </record>
</odoo>
