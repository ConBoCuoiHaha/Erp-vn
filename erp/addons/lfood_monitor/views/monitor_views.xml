<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_error_log_list" model="ir.ui.view">
        <field name="name">lfood.error.log.list</field>
        <field name="model">lfood.error.log</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'new'" decoration-muted="state == 'ignored'">
                <field name="last_seen"/>
                <field name="source"/>
                <field name="message"/>
                <field name="count" sum="Tổng số lần"/>
                <field name="user_id"/>
                <field name="url" optional="hide"/>
                <field name="state"/>
                <button name="action_seen" type="object" string="Đã xem" icon="fa-check" invisible="state == 'seen'"/>
                <button name="action_ignore" type="object" string="Bỏ qua" icon="fa-ban" invisible="state == 'ignored'"/>
            </list>
        </field>
    </record>

    <record id="view_error_log_form" model="ir.ui.view">
        <field name="name">lfood.error.log.form</field>
        <field name="model">lfood.error.log</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_seen" type="object" string="Đánh dấu đã xem" invisible="state == 'seen'"/>
                    <button name="action_ignore" type="object" string="Bỏ qua lỗi này" invisible="state == 'ignored'"/>
                    <button name="action_reopen" type="object" string="Mở lại" invisible="state == 'new'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <h2><field name="message" readonly="1"/></h2>
                    <group>
                        <group>
                            <field name="source" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="url" widget="url" readonly="1"/>
                        </group>
                        <group>
                            <field name="count" readonly="1"/>
                            <field name="first_seen" readonly="1"/>
                            <field name="last_seen" readonly="1"/>
                            <field name="browser" readonly="1"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Ghi chú của người xử lý"/>
                    <field name="detail" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_error_log_search" model="ir.ui.view">
        <field name="name">lfood.error.log.search</field>
        <field name="model">lfood.error.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="message"/>
                <field name="user_id"/>
                <filter name="f_new" string="Chưa xem" domain="[('state', '=', 'new')]"/>
                <filter name="f_browser" string="Lỗi trình duyệt" domain="[('source', '=', 'browser')]"/>
                <filter name="f_server" string="Lỗi máy chủ" domain="[('source', '=', 'server')]"/>
                <group>
                    <filter name="g_source" string="Nơi xảy ra" context="{'group_by': 'source'}"/>
                    <filter name="g_user" string="Người gặp" context="{'group_by': 'user_id'}"/>
                    <filter name="g_day" string="Ngày" context="{'group_by': 'last_seen:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_error_log" model="ir.actions.act_window">
        <field name="name">Lỗi kỹ thuật</field>
        <field name="res_model">lfood.error.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_f_new': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có lỗi nào. Tốt.</p>
            <p>Lỗi JavaScript trên máy người dùng và cảnh báo sức khỏe hệ thống đều về đây, gom theo từng loại
               kèm số lần gặp. Dữ liệu nằm trên máy này, không gửi ra dịch vụ bên ngoài.</p>
        </field>
    </record>

    <record id="view_system_status_form" model="ir.ui.view">
        <field name="name">lfood.system.status.form</field>
        <field name="model">lfood.system.status</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h2>Tình trạng hệ thống</h2>
                    <field name="html" nolabel="1" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_system_status" model="ir.actions.act_window">
        <field name="name">Tình trạng hệ thống</field>
        <field name="res_model">lfood.system.status</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_server_log_form" model="ir.ui.view">
        <field name="name">lfood.server.log.form</field>
        <field name="model">lfood.server.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group><field name="level"/><field name="lines"/></group>
                        <group><field name="keyword" placeholder="ví dụ lfood_voucher"/></group>
                    </group>
                    <field name="html" nolabel="1" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_server_log" model="ir.actions.act_window">
        <field name="name">Nhật ký máy chủ</field>
        <field name="res_model">lfood.server.log</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_system_status" name="Tình trạng hệ thống" parent="lfood_admin.menu_admin"
              action="action_system_status" sequence="1" groups="lfood_base.group_chief_accountant"/>
    <menuitem id="menu_error_log" name="Lỗi kỹ thuật" parent="lfood_admin.menu_admin"
              action="action_error_log" sequence="2" groups="lfood_base.group_chief_accountant"/>
    <menuitem id="menu_server_log" name="Nhật ký máy chủ" parent="lfood_admin.menu_admin"
              action="action_server_log" sequence="3" groups="base.group_system"/>
</odoo>
