<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_daily_check" model="ir.cron">
        <field name="name">Giám sát: kiểm tra sức khỏe hệ thống hằng ngày</field>
        <field name="model_id" ref="model_lfood_error_log"/>
        <field name="state">code</field>
        <field name="code">model._daily_check()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
