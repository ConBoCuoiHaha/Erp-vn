<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_lfood_list" model="ir.ui.view">
        <field name="name">res.company.lfood.list</field>
        <field name="model">res.company</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Pháp nhân">
                <field name="lfood_code"/>
                <field name="name"/>
                <field name="vat" string="Mã số thuế"/>
                <field name="lfood_voucher_approval_limit"/>
                <field name="lfood_edit_after_post_days"/>
            </list>
        </field>
    </record>
    <record id="view_company_lfood_form" model="ir.ui.view">
        <field name="name">res.company.lfood.form</field>
        <field name="model">res.company</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form string="Pháp nhân">
                <sheet>
                    <group>
                        <group string="Thông tin">
                            <field name="lfood_code"/>
                            <field name="name"/>
                            <field name="vat" string="Mã số thuế"/>
                            <field name="street" string="Địa chỉ"/>
                        </group>
                        <group string="Quy chế chứng từ">
                            <field name="lfood_voucher_approval_limit"/>
                            <field name="lfood_edit_after_post_days"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_company_lfood" model="ir.actions.act_window">
        <field name="name">Pháp nhân và quy chế chứng từ</field>
        <field name="res_model">res.company</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_company_lfood_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_company_lfood_list"/>
        <field name="act_window_id" ref="action_company_lfood"/>
    </record>
    <record id="action_company_lfood_form" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_company_lfood_form"/>
        <field name="act_window_id" ref="action_company_lfood"/>
    </record>
    <menuitem id="menu_company_lfood" name="Pháp nhân, hạn mức duyệt" parent="menu_config"
              action="action_company_lfood" sequence="5" groups="group_chief_accountant,group_sysadmin"/>
</odoo>
