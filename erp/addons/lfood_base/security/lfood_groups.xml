<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_lfood" model="ir.module.category">
        <field name="name">LiFeOOD</field>
        <field name="sequence">1</field>
    </record>

    <!-- Kế toán: Nhân viên < Kế toán viên < Kế toán trưởng (chọn 1 trên hồ sơ người dùng) -->
    <record id="privilege_lfood_accounting" model="res.groups.privilege">
        <field name="name">Kế toán LiFeOOD</field>
        <field name="category_id" ref="module_category_lfood"/>
        <field name="sequence">1</field>
    </record>
    <record id="group_employee" model="res.groups">
        <field name="name">Nhân viên</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_lfood_accounting"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Xem thông tin chung. Không xem chứng từ kế toán.</field>
    </record>
    <record id="group_accountant" model="res.groups">
        <field name="name">Kế toán viên</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_lfood_accounting"/>
        <field name="implied_ids" eval="[(4, ref('group_employee')), (4, ref('base.group_allow_export')), (4, ref('base.group_partner_manager'))]"/>
        <field name="comment">Lập, sửa chứng từ nháp, Cất chứng từ, xem báo cáo.</field>
    </record>
    <record id="group_chief_accountant" model="res.groups">
        <field name="name">Kế toán trưởng</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="privilege_lfood_accounting"/>
        <field name="implied_ids" eval="[(4, ref('group_accountant'))]"/>
        <field name="comment">Duyệt, Sửa chứng từ đã cất, điều chỉnh hàng loạt, cấu hình, xem nhật ký hệ thống.</field>
    </record>

    <!-- Điều hành -->
    <record id="privilege_lfood_director" model="res.groups.privilege">
        <field name="name">Điều hành LiFeOOD</field>
        <field name="category_id" ref="module_category_lfood"/>
        <field name="sequence">2</field>
    </record>
    <record id="group_director" model="res.groups">
        <field name="name">Giám đốc</field>
        <field name="privilege_id" ref="privilege_lfood_director"/>
        <field name="implied_ids" eval="[(4, ref('group_employee')), (4, ref('base.group_allow_export'))]"/>
        <field name="comment">Xem mọi chứng từ và báo cáo, duyệt chứng từ vượt hạn mức, xem nhật ký. Không sửa số liệu.</field>
    </record>

    <!-- R&D: tách riêng, không có quyền kế toán; kế toán cũng không có quyền R&D -->
    <record id="privilege_lfood_rnd" model="res.groups.privilege">
        <field name="name">Nghiên cứu &amp; phát triển</field>
        <field name="category_id" ref="module_category_lfood"/>
        <field name="sequence">3</field>
    </record>
    <record id="group_rnd" model="res.groups">
        <field name="name">R&amp;D</field>
        <field name="privilege_id" ref="privilege_lfood_rnd"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Bộ phận R&amp;D. Không thấy chứng từ, báo cáo, nhật ký kế toán.</field>
    </record>

    <!-- Quản trị -->
    <record id="privilege_lfood_admin" model="res.groups.privilege">
        <field name="name">Quản trị LiFeOOD</field>
        <field name="category_id" ref="module_category_lfood"/>
        <field name="sequence">4</field>
    </record>
    <record id="group_sysadmin" model="res.groups">
        <field name="name">Quản trị hệ thống</field>
        <field name="privilege_id" ref="privilege_lfood_admin"/>
        <field name="implied_ids" eval="[(4, ref('group_chief_accountant')), (4, ref('group_director')), (4, ref('group_rnd')), (4, ref('base.group_system')), (4, ref('base.group_erp_manager')), (4, ref('base.group_allow_export')), (4, ref('base.group_partner_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Toàn quyền: người dùng, phân quyền, pháp nhân, danh mục, cấu hình, sao lưu, mọi chứng từ. Không sửa được nhật ký hệ thống.</field>
    </record>
</odoo>
