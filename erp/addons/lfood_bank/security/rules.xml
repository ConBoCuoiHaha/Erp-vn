<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_bank_account_company" model="ir.rule">
        <field name="name">Tài khoản ngân hàng theo công ty được phép</field>
        <field name="model_id" ref="model_lfood_bank_account"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_statement_company" model="ir.rule">
        <field name="name">Sổ phụ ngân hàng theo công ty được phép</field>
        <field name="model_id" ref="model_lfood_bank_statement"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
