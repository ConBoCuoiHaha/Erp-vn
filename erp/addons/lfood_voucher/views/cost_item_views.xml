<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cost_item_list" model="ir.ui.view">
        <field name="name">lfood.cost.item.list</field>
        <field name="model">lfood.cost.item</field>
        <field name="arch" type="xml">
            <list string="Khoản mục chi phí" editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="parent_id" options="{'no_create': True}"/>
                <field name="level" readonly="1"/>
                <field name="accounts"/>
                <field name="company_id" optional="hide"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_cost_item_search" model="ir.ui.view">
        <field name="name">lfood.cost.item.search</field>
        <field name="model">lfood.cost.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="parent_id" operator="child_of"/>
                <filter name="inactive" string="Đã ngừng dùng" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="action_cost_item" model="ir.actions.act_window">
        <field name="name">Khoản mục chi phí</field>
        <field name="res_model">lfood.cost.item</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
