<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_service_voucher" model="ir.sequence">
        <field name="name">Chứng từ mua dịch vụ</field>
        <field name="code">lfood.service.voucher</field>
        <field name="prefix">MDV</field>
        <field name="padding">5</field>
        <field name="number_next">433</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_bulk_batch" model="ir.sequence">
        <field name="name">Lô điều chỉnh hàng loạt</field>
        <field name="code">lfood.voucher.bulk.batch</field>
        <field name="prefix">LDC%(year)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
