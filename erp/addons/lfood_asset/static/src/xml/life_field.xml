<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="lfood_asset.LifeField">
        <span t-if="props.readonly" t-esc="formattedValue"/>
        <input t-else=""
               t-on-focusin="onFocusIn"
               t-on-focusout="onFocusOut"
               t-on-input="onInput"
               t-att-id="props.id"
               t-ref="numpadDecimal"
               t-att-type="props.inputType"
               inputmode="decimal"
               class="o_input"
               autocomplete="off"
               t-att-step="props.step"/>
        <span t-if="showMonths" class="text-muted ms-2 text-nowrap">= <t t-esc="months"/> tháng</span>
    </t>

</templates>
