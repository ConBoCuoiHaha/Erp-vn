<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_depreciation_list" model="ir.ui.view">
        <field name="name">lfood.asset.depreciation.list</field>
        <field name="model">lfood.asset.depreciation</field>
        <field name="arch" type="xml">
            <list string="Chứng từ khấu hao TSCĐ" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="date"/>
                <field name="memo"/>
                <field name="amount_total" sum="Tổng"/>
                <field name="posted_by" optional="show"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'"/>
            </list>
        </field>
    </record>

    <record id="view_depreciation_form" model="ir.ui.view">
        <field name="name">lfood.asset.depreciation.form</field>
        <field name="model">lfood.asset.depreciation</field>
        <field name="arch" type="xml">
            <form string="Chứng từ khấu hao TSCĐ">
                <header>
                    <button name="action_compute" type="object" string="Tính khấu hao" class="btn-primary"
                            invisible="state != 'draft' or line_ids" groups="lfood_base.group_accountant"/>
                    <button name="action_compute" type="object" string="Tính lại"
                            invisible="state != 'draft' or not line_ids" groups="lfood_base.group_accountant"/>
                    <button name="action_post" type="object" string="Ghi sổ" class="btn-primary"
                            invisible="state != 'draft' or not line_ids" groups="lfood_base.group_accountant"/>
                    <button name="action_cancel" type="object" string="Hủy chứng từ"
                            invisible="state == 'cancel'" groups="lfood_base.group_chief_accountant"
                            confirm="Hủy chứng từ khấu hao? Các kỳ khấu hao sẽ trở lại chưa ghi."/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_audit" type="object" class="oe_stat_button" icon="fa-history"
                                string="Nhật ký" groups="lfood_base.group_chief_accountant,lfood_base.group_director"/>
                    </div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="date" readonly="state != 'draft' or line_ids"/>
                            <field name="memo"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft' or line_ids"/>
                        </group>
                        <group>
                            <field name="amount_total" class="o_lfood_big_total"/>
                            <field name="posted_by" invisible="not posted_by"/>
                            <field name="posted_on" invisible="not posted_on"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list>
                            <field name="asset_code"/>
                            <field name="asset_id"/>
                            <field name="usage" optional="show"/>
                            <field name="account_expense"/>
                            <field name="account_depreciation"/>
                            <field name="amount" sum="Tổng"/>
                            <field name="cost_item_id"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_depreciation_search" model="ir.ui.view">
        <field name="name">lfood.asset.depreciation.search</field>
        <field name="model">lfood.asset.depreciation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="f_draft" string="Nháp" domain="[('state', '=', 'draft')]"/>
                <filter name="f_posted" string="Đã ghi sổ" domain="[('state', '=', 'posted')]"/>
                <filter name="f_date" string="Kỳ" date="date"/>
            </search>
        </field>
    </record>

    <record id="action_depreciation" model="ir.actions.act_window">
        <field name="name">Chứng từ khấu hao TSCĐ</field>
        <field name="res_model">lfood.asset.depreciation</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Cuối tháng bấm Mới, chọn kỳ, bấm Tính khấu hao rồi Ghi sổ. Mỗi tài sản một dòng theo lịch khấu hao.</p>
        </field>
    </record>
</odoo>
