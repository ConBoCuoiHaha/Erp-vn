<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_lead_company" model="ir.rule">
        <field name="name">Cơ hội bán hàng theo công ty được phép</field>
        <field name="model_id" ref="model_lfood_sale_lead"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="view_lead_kanban" model="ir.ui.view">
        <field name="name">lfood.sale.lead.kanban</field>
        <field name="model">lfood.sale.lead</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage" quick_create="false">
                <field name="stage"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <field name="prospect"/>
                        <div class="d-flex justify-content-between">
                            <field name="expected_revenue"/>
                            <field name="next_date"/>
                        </div>
                        <field name="user_id" widget="many2one_avatar_user"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="view_lead_list" model="ir.ui.view">
        <field name="name">lfood.sale.lead.list</field>
        <field name="model">lfood.sale.lead</field>
        <field name="arch" type="xml">
            <list string="Cơ hội bán hàng" decoration-danger="next_date and next_date &lt; current_date and stage not in ('won', 'lost')">
                <field name="name"/><field name="prospect"/><field name="channel_id"/><field name="user_id"/>
                <field name="stage"/><field name="expected_revenue" sum="Tổng"/><field name="weighted_revenue" sum="Tổng"/>
                <field name="next_action"/><field name="next_date"/>
            </list>
        </field>
    </record>
    <record id="view_lead_form" model="ir.ui.view">
        <field name="name">lfood.sale.lead.form</field>
        <field name="model">lfood.sale.lead</field>
        <field name="arch" type="xml">
            <form string="Cơ hội bán hàng">
                <header>
                    <button name="action_won" type="object" string="Thành công" class="btn-primary" invisible="stage in ('won', 'lost')"/>
                    <button name="action_lost" type="object" string="Thất bại" invisible="stage in ('won', 'lost')"/>
                    <button name="action_reopen" type="object" string="Mở lại" invisible="stage != 'lost'"/>
                    <field name="stage" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Ví dụ: Chuỗi siêu thị X - cháo hũ"/></h1></div>
                    <group>
                        <group>
                            <field name="prospect"/>
                            <field name="vat"/>
                            <field name="partner_id"/>
                            <field name="contact_name"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="city"/>
                        </group>
                        <group>
                            <field name="channel_id"/>
                            <field name="user_id"/>
                            <field name="expected_revenue"/>
                            <field name="probability"/>
                            <field name="weighted_revenue"/>
                            <field name="next_action"/>
                            <field name="next_date"/>
                            <field name="lost_reason" invisible="stage == 'won'"/>
                            <field name="order_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Ghi chú các lần chăm sóc"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_lead_search" model="ir.ui.view">
        <field name="name">lfood.sale.lead.search</field>
        <field name="model">lfood.sale.lead</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="prospect"/>
                <field name="user_id"/>
                <filter name="mine" string="Của tôi" domain="[('user_id', '=', uid)]"/>
                <filter name="open" string="Đang theo" domain="[('stage', 'not in', ('won', 'lost'))]"/>
                <filter name="late" string="Quá hạn việc tiếp theo" domain="[('next_date', '&lt;', context_today().strftime('%Y-%m-%d')), ('stage', 'not in', ('won', 'lost'))]"/>
            </search>
        </field>
    </record>
    <record id="action_lead" model="ir.actions.act_window">
        <field name="name">Cơ hội bán hàng</field>
        <field name="res_model">lfood.sale.lead</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
    <menuitem id="menu_lead" name="Cơ hội bán hàng" parent="lfood_sale.menu_sale_root" action="action_lead" sequence="3"/>
</odoo>
