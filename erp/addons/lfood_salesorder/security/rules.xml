<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_pricelist_company" model="ir.rule">
        <field name="name">Bảng giá theo công ty được phép</field>
        <field name="model_id" ref="model_lfood_pricelist"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sale_order_company" model="ir.rule">
        <field name="name">Đơn bán theo công ty được phép</field>
        <field name="model_id" ref="model_lfood_sale_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sale_order_line_company" model="ir.rule">
        <field name="name">Dòng đơn bán theo công ty được phép</field>
        <field name="model_id" ref="model_lfood_sale_order_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
