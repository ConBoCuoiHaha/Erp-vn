<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_move_company" model="ir.rule">
        <field name="name">Bút toán theo công ty được phép</field>
        <field name="model_id" ref="model_lfood_move"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_move_line_company" model="ir.rule">
        <field name="name">Dòng định khoản theo công ty được phép</field>
        <field name="model_id" ref="model_lfood_move_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_payment_company" model="ir.rule">
        <field name="name">Phiếu thu chi theo công ty được phép</field>
        <field name="model_id" ref="model_lfood_payment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
