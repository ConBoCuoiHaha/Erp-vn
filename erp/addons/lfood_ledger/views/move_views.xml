<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_list" model="ir.ui.view">
        <field name="name">lfood.move.list</field>
        <field name="model">lfood.move</field>
        <field name="arch" type="xml">
            <list string="Bút toán" decoration-muted="reversed_by_id or reversal_of_id" decoration-info="state == 'draft'">
                <field name="date"/>
                <field name="name"/>
                <field name="journal"/>
                <field name="ref"/>
                <field name="memo"/>
                <field name="amount" sum="Tổng"/>
                <field name="posted_by" optional="show"/>
                <field name="reversed_by_id" optional="hide"/>
                <field name="reversal_of_id" optional="hide"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'"/>
            </list>
        </field>
    </record>

    <record id="view_move_form" model="ir.ui.view">
        <field name="name">lfood.move.form</field>
        <field name="model">lfood.move</field>
        <field name="arch" type="xml">
            <form string="Bút toán">
                <header>
                    <button name="action_post" type="object" string="Ghi sổ" class="btn-primary"
                            invisible="state != 'draft' or source_model" groups="lfood_base.group_accountant"/>
                    <button name="action_reverse" type="object" string="Đảo bút toán"
                            invisible="state != 'posted' or reversed_by_id or reversal_of_id or (source_model and journal != 'closing')"
                            groups="lfood_base.group_chief_accountant"
                            confirm="Lập bút toán đảo ngược dấu, ghi vào ngày hôm nay?"/>
                    <button name="action_open_source" type="object" string="Mở chứng từ nguồn" invisible="not source_model or journal == 'closing'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_audit" type="object" class="oe_stat_button" icon="fa-history"
                                string="Nhật ký" groups="lfood_base.group_chief_accountant,lfood_base.group_director"/>
                    </div>
                    <div class="alert alert-secondary" role="alert" invisible="not reversed_by_id">
                        Bút toán này đã bị đảo bởi <field name="reversed_by_id" readonly="1" class="oe_inline"/>.
                    </div>
                    <div class="alert alert-secondary" role="alert" invisible="not reversal_of_id">
                        Đây là bút toán đảo của <field name="reversal_of_id" readonly="1" class="oe_inline"/>.
                    </div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="journal" readonly="state != 'draft' or source_model"/>
                            <field name="date" readonly="state != 'draft' or source_model"/>
                            <field name="ref" readonly="state != 'draft' or source_model"/>
                            <field name="memo" readonly="state != 'draft' or source_model"/>
                        </group>
                        <group>
                            <field name="amount" class="o_lfood_big_total"/>
                            <field name="source_display" invisible="not source_model"/>
                            <field name="source_model" invisible="1"/>
                            <field name="posted_by" invisible="not posted_by"/>
                            <field name="posted_on" invisible="not posted_on"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft' or source_model"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'draft' or source_model">
                        <list editable="bottom">
                            <field name="account_id" options="{'no_create': True}"/>
                            <field name="partner_id"/>
                            <field name="name"/>
                            <field name="debit" sum="Nợ"/>
                            <field name="credit" sum="Có"/>
                            <field name="cost_item_id" optional="show"/>
                        </list>
                    </field>
                    <div class="text-muted" invisible="state != 'draft'">
                        Tổng Nợ phải bằng tổng Có. Tài khoản 131, 136, 138, 141, 331, 334, 336, 338 phải ghi đối tượng.
                        Bút toán đã ghi sổ không sửa, không xóa được; sai thì Kế toán trưởng Đảo bút toán rồi lập bút toán mới.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_move_search" model="ir.ui.view">
        <field name="name">lfood.move.search</field>
        <field name="model">lfood.move</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Số bút toán, chứng từ" filter_domain="['|', '|', ('name', 'ilike', self), ('ref', 'ilike', self), ('memo', 'ilike', self)]"/>
                <field name="line_ids" string="Tài khoản" filter_domain="[('line_ids.account_code', '=like', self + '%')]"/>
                <filter name="f_draft" string="Nháp" domain="[('state', '=', 'draft')]"/>
                <filter name="f_posted" string="Đã ghi sổ" domain="[('state', '=', 'posted')]"/>
                <separator/>
                <filter name="f_general" string="Phiếu kế toán" domain="[('journal', '=', 'general')]"/>
                <filter name="f_opening" string="Số dư đầu kỳ" domain="[('journal', '=', 'opening')]"/>
                <filter name="f_closing" string="Kết chuyển" domain="[('journal', '=', 'closing')]"/>
                <filter name="f_date" string="Ngày hạch toán" date="date"/>
                <group>
                    <filter name="g_journal" string="Sổ nhật ký" context="{'group_by': 'journal'}"/>
                    <filter name="g_month" string="Tháng" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_move" model="ir.actions.act_window">
        <field name="name">Bút toán</field>
        <field name="res_model">lfood.move</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_move_general" model="ir.actions.act_window">
        <field name="name">Phiếu kế toán</field>
        <field name="res_model">lfood.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('journal', '=', 'general')]</field>
        <field name="context">{'default_journal': 'general'}</field>
        <field name="help" type="html"><p>Dùng cho trích trước, phân bổ, điều chỉnh, bút toán không có chứng từ nghiệp vụ riêng.</p></field>
    </record>
    <record id="action_move_opening" model="ir.actions.act_window">
        <field name="name">Số dư đầu kỳ</field>
        <field name="res_model">lfood.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('journal', '=', 'opening')]</field>
        <field name="context">{'default_journal': 'opening'}</field>
        <field name="help" type="html"><p>Nhập số dư các tài khoản chuyển từ MISA vào ngày trước ngày bắt đầu dùng app. Công nợ ghi theo từng đối tượng.</p></field>
    </record>

    <!-- sổ nhật ký chung -->
    <record id="view_move_line_list" model="ir.ui.view">
        <field name="name">lfood.move.line.list</field>
        <field name="model">lfood.move.line</field>
        <field name="arch" type="xml">
            <list string="Sổ nhật ký chung" create="false" edit="false" delete="false">
                <field name="date"/>
                <field name="move_id"/>
                <field name="ref"/>
                <field name="name"/>
                <field name="account_code"/>
                <field name="partner_id" optional="show"/>
                <field name="debit" sum="Nợ"/>
                <field name="credit" sum="Có"/>
                <field name="cost_item_id" optional="hide"/>
                <field name="journal" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_move_line_pivot" model="ir.ui.view">
        <field name="name">lfood.move.line.pivot</field>
        <field name="model">lfood.move.line</field>
        <field name="arch" type="xml">
            <pivot string="Phát sinh theo tài khoản">
                <field name="account_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="balance" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_move_line_search" model="ir.ui.view">
        <field name="name">lfood.move.line.search</field>
        <field name="model">lfood.move.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="account_code" string="Tài khoản" filter_domain="[('account_code', '=like', self + '%')]"/>
                <field name="partner_id"/>
                <field name="name"/>
                <field name="ref"/>
                <filter name="f_posted" string="Đã ghi sổ" domain="[('state', '=', 'posted')]"/>
                <filter name="f_date" string="Ngày hạch toán" date="date"/>
                <group>
                    <filter name="g_account" string="Tài khoản" context="{'group_by': 'account_id'}"/>
                    <filter name="g_partner" string="Đối tượng" context="{'group_by': 'partner_id'}"/>
                    <filter name="g_month" string="Tháng" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_move_line" model="ir.actions.act_window">
        <field name="name">Sổ nhật ký chung</field>
        <field name="res_model">lfood.move.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="context">{'search_default_f_posted': 1}</field>
    </record>
</odoo>
