<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_budget_company" model="ir.rule">
        <field name="name">Ngân sách theo công ty được phép</field>
        <field name="model_id" ref="model_lfood_budget"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_budget_line_company" model="ir.rule">
        <field name="name">Dòng ngân sách theo công ty được phép</field>
        <field name="model_id" ref="model_lfood_budget_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_budget_report_company" model="ir.rule">
        <field name="name">Báo cáo ngân sách theo công ty được phép</field>
        <field name="model_id" ref="model_lfood_budget_report"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
