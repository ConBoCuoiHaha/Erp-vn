<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- === bảng nhập liệu -->
    <record id="view_entry_sheet_list" model="ir.ui.view">
        <field name="name">lfood.entry.sheet.list</field>
        <field name="model">lfood.entry.sheet</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'posted'">
                <field name="name"/>
                <field name="journal"/>
                <field name="total_debit" sum="Cộng Nợ"/>
                <field name="error_count"/>
                <field name="move_count"/>
                <field name="state"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_entry_sheet_form" model="ir.ui.view">
        <field name="name">lfood.entry.sheet.form</field>
        <field name="model">lfood.entry.sheet</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_check" type="object" string="Kiểm tra" invisible="state != 'draft'"/>
                    <button name="action_post" type="object" string="Ghi sổ" class="btn-primary"
                            invisible="state != 'draft'"
                            confirm="Ghi sổ toàn bộ các dòng trong bảng thành bút toán?"/>
                    <button name="action_open_moves" type="object" string="Xem bút toán" invisible="move_count == 0"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status" invisible="state != 'draft'">
                        Mỗi dòng là một vế Nợ - Có. Cần nhiều tài khoản trong cùng một bút toán thì nhập nhiều dòng
                        có cùng Ngày và Số chứng từ. Bỏ trống Ngày, Số chứng từ, Diễn giải thì hệ thống lấy của dòng
                        ngay trên, giống kéo ô trong Excel.
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="journal" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="total_debit"/>
                            <field name="total_credit"/>
                            <field name="error_count"/>
                            <field name="move_count" invisible="move_count == 0"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom" decoration-danger="error">
                            <field name="sequence" widget="handle"/>
                            <field name="date"/>
                            <field name="ref"/>
                            <field name="memo"/>
                            <field name="debit_account_id" options="{'no_create': True}"/>
                            <field name="credit_account_id" options="{'no_create': True}"/>
                            <field name="amount" sum="Cộng"/>
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="cost_item_id" options="{'no_create': True}"/>
                            <field name="error" readonly="1" widget="badge" decoration-danger="error"/>
                        </list>
                    </field>
                    <field name="note" placeholder="Ghi chú"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_entry_sheet" model="ir.actions.act_window">
        <field name="name">Bảng nhập liệu</field>
        <field name="res_model">lfood.entry.sheet</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nhập nhiều bút toán liên tiếp trên một lưới.</p>
            <p>Gõ như trong Excel: Ngày, Số chứng từ, Diễn giải, TK Nợ, TK Có, Số tiền. Bấm Kiểm tra để soát
               theo ràng buộc đã cấu hình, rồi Ghi sổ một lần cho cả bảng.</p>
        </field>
    </record>

    <menuitem id="menu_entry_sheet" name="Bảng nhập liệu" parent="lfood_base.menu_documents"
              action="action_entry_sheet" sequence="5" groups="lfood_base.group_accountant"/>

    <!-- === ràng buộc nhập liệu -->
    <record id="view_entry_rule_list" model="ir.ui.view">
        <field name="name">lfood.entry.rule.list</field>
        <field name="model">lfood.entry.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="account_prefix" placeholder="mọi tài khoản"/>
                <field name="side"/>
                <field name="require_partner"/>
                <field name="require_cost_item"/>
                <field name="require_memo"/>
                <field name="require_ref"/>
                <field name="max_amount"/>
                <field name="forbid"/>
                <field name="message" optional="hide"/>
                <field name="active" optional="show" widget="boolean_toggle"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_entry_rule" model="ir.actions.act_window">
        <field name="name">Ràng buộc nhập liệu</field>
        <field name="res_model">lfood.entry.rule</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Đặt luật cho bảng nhập liệu.</p>
            <p>Ví dụ: tài khoản đầu 62 bên Nợ bắt buộc có khoản mục chi phí; tài khoản 154 cấm hạch toán tay;
               mỗi dòng không quá một mức tiền nhất định.</p>
        </field>
    </record>

    <menuitem id="menu_entry_rule" name="Ràng buộc nhập liệu" parent="lfood_base.menu_config"
              action="action_entry_rule" sequence="35" groups="lfood_base.group_chief_accountant"/>
</odoo>
