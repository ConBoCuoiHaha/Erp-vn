<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_sale_invoice_company" model="ir.rule">
        <field name="name">Hóa đơn bán ra theo công ty được phép</field>
        <field name="model_id" ref="model_lfood_sale_invoice"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sale_line_company" model="ir.rule">
        <field name="name">Dòng hóa đơn bán ra theo công ty được phép</field>
        <field name="model_id" ref="model_lfood_sale_invoice_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
