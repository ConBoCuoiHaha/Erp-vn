    <record id="rule_final_company" model="ir.rule">
        <field name="name">Quyết toán thuế TNDN theo công ty được phép</field>
        <field name="model_id" ref="model_lfood_cit_finalization"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
