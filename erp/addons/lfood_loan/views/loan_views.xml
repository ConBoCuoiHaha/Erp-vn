<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_loan_list" model="ir.ui.view">
        <field name="name">lfood.loan.list</field>
        <field name="model">lfood.loan</field>
        <field name="arch" type="xml">
            <list string="Hợp đồng vay" decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="contract_ref"/>
                <field name="principal" sum="Số vay"/>
                <field name="rate"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="outstanding"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_loan_form" model="ir.ui.view">
        <field name="name">lfood.loan.form</field>
        <field name="model">lfood.loan</field>
        <field name="arch" type="xml">
            <form string="Hợp đồng vay">
                <header>
                    <button name="action_disburse" type="object" string="Ghi nhận giải ngân" class="btn-primary"
                            invisible="state != 'draft'" groups="lfood_base.group_chief_accountant"/>
                    <button name="action_pay" type="object" string="Lập phiếu trả gốc" context="{'loan_part': 'principal'}"
                            invisible="state != 'running'" groups="lfood_base.group_accountant"/>
                    <button name="action_pay" type="object" string="Lập phiếu trả lãi" context="{'loan_part': 'interest'}"
                            invisible="state != 'running'" groups="lfood_base.group_accountant"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="lender_type" readonly="state != 'draft'"/>
                            <field name="contract_ref" readonly="state != 'draft'"/>
                            <field name="purpose"/>
                            <field name="principal" readonly="state != 'draft'"/>
                            <field name="rate" readonly="state != 'draft'"/>
                            <field name="basis" readonly="state != 'draft'"/>
                            <field name="date_start" readonly="state != 'draft'"/>
                            <field name="date_end" readonly="state != 'draft'"/>
                            <field name="cash_account" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="outstanding"/>
                            <field name="principal_paid"/>
                            <field name="interest_accrued"/>
                            <field name="interest_paid"/>
                            <field name="accrued_to"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lịch trả gốc">
                            <group invisible="state != 'draft'">
                                <group>
                                    <field name="installment_count"/>
                                    <field name="installment_months"/>
                                    <field name="first_due"/>
                                </group>
                                <group>
                                    <button name="action_make_schedule" type="object" string="Lập lịch trả đều"/>
                                </group>
                            </group>
                            <field name="schedule_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="due_date"/>
                                    <field name="amount" sum="Tổng gốc"/>
                                </list>
                            </field>
                            <div class="text-muted">Có lịch trả gốc thì B01 trình bày phần gốc đến hạn trong 12 tháng là vay ngắn hạn,
                                phần còn lại là dài hạn; không có lịch thì xét cả khoản theo ngày đáo hạn.</div>
                        </page>
                        <page string="Trích lãi">
                            <field name="accrual_ids" readonly="1">
                                <list>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="amount" sum="Lãi"/>
                                    <field name="nondeductible" sum="Không được trừ"/>
                                </list>
                            </field>
                        </page>
                        <page string="Phiếu trả nợ">
                            <field name="payment_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="loan_part"/>
                                    <field name="amount"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <div class="text-muted">
                        Tài khoản 3411 theo Thông tư 99/2025/TT-BTC. Lãi tính theo dư nợ thực tế từng ngày: ngày giải ngân có tính lãi,
                        ngày trả gốc không tính lãi phần đã trả. Vay của tổ chức, cá nhân không phải tổ chức tín dụng: phần lãi suất vượt
                        mức Bộ luật Dân sự (20%/năm) không được trừ khi tính thuế TNDN (Nghị định 320/2025/NĐ-CP).
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_loan" model="ir.actions.act_window">
        <field name="name">Hợp đồng vay</field>
        <field name="res_model">lfood.loan</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_loan_accrue_form" model="ir.ui.view">
        <field name="name">lfood.loan.accrue.form</field>
        <field name="model">lfood.loan.accrue</field>
        <field name="arch" type="xml">
            <form string="Trích lãi vay cuối kỳ">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="date_to"/>
                    <field name="result" invisible="not result"/>
                </group>
                <footer>
                    <button name="action_run" type="object" string="Trích lãi" class="btn-primary"/>
                    <button special="cancel" string="Đóng"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_loan_accrue" model="ir.actions.act_window">
        <field name="name">Trích lãi vay cuối kỳ</field>
        <field name="res_model">lfood.loan.accrue</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_payment_form_loan" model="ir.ui.view">
        <field name="name">lfood.payment.form.loan</field>
        <field name="model">lfood.payment</field>
        <field name="inherit_id" ref="lfood_ledger.view_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='purpose']" position="after">
                <field name="loan_id" invisible="purpose != 'loan'" required="purpose == 'loan'" readonly="state != 'draft'"
                       options="{'no_create': True}"/>
                <field name="loan_part" invisible="purpose != 'loan'" required="purpose == 'loan'" readonly="state != 'draft'"/>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_loan" name="Vay, lãi vay" parent="lfood_ledger.menu_ledger_root" action="action_loan" sequence="13"/>
    <menuitem id="menu_loan_accrue" name="Trích lãi vay cuối kỳ" parent="lfood_ledger.menu_ledger_root" action="action_loan_accrue" sequence="14"/>
</odoo>
