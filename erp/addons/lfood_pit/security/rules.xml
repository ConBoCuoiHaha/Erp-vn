<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_salary_advance_company" model="ir.rule">
        <field name="name">Tạm ứng lương theo công ty được phép</field>
        <field name="model_id" ref="model_lfood_salary_advance"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_pit_freelance_company" model="ir.rule">
        <field name="name">Chi trả thu nhập vãng lai theo công ty được phép</field>
        <field name="model_id" ref="model_lfood_pit_freelance"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_pit_settlement_company" model="ir.rule">
        <field name="name">Quyết toán thuế TNCN theo công ty được phép</field>
        <field name="model_id" ref="model_lfood_pit_settlement"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
