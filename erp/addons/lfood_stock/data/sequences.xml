    <record id="seq_stock_out" model="ir.sequence"><field name="name">Phiếu xuất kho</field><field name="code">lfood.stock.out</field><field name="prefix">PX%(year)s/</field><field name="padding">5</field><field name="company_id" eval="False"/></record>
