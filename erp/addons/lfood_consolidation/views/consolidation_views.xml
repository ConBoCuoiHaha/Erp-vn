<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_consolidation_form" model="ir.ui.view">
        <field name="name">lfood.consolidation.report.form</field>
        <field name="model">lfood.consolidation.report</field>
        <field name="arch" type="xml">
            <form string="Hợp nhất hai pháp nhân">
                <group>
                    <group><field name="company_a_id"/><field name="company_b_id"/></group>
                    <group><field name="date_from"/><field name="date_to"/></group>
                </group>
                <field name="report_html"/>
                <footer>
                    <button name="action_compute" type="object" string="Xem" class="btn-primary"/>
                    <button string="Đóng" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_consolidation" model="ir.actions.act_window">
        <field name="name">Hợp nhất hai pháp nhân</field>
        <field name="res_model">lfood.consolidation.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_consolidation" name="Hợp nhất hai pháp nhân" parent="lfood_base.menu_reports"
              action="action_consolidation" sequence="70" groups="lfood_base.group_chief_accountant,lfood_base.group_director"/>
</odoo>
