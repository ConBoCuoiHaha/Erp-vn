<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_reminder_list" model="ir.ui.view">
        <field name="name">lfood.reminder.list</field>
        <field name="model">lfood.reminder</field>
        <field name="arch" type="xml">
            <list string="Việc sắp đến hạn" create="false" decoration-danger="state == 'open' and days_left &lt; 0"
                  decoration-warning="state == 'open' and days_left &gt;= 0 and days_left &lt;= 7"
                  decoration-muted="state == 'done'">
                <header>
                    <button name="action_done" type="object" string="Đã xử lý"/>
                </header>
                <field name="due_date"/>
                <field name="days_left"/>
                <field name="category"/>
                <field name="title"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state"/>
                <field name="done_note" optional="hide"/>
                <button name="action_open" type="object" string="Mở" icon="fa-external-link" invisible="not res_id"/>
                <field name="res_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_reminder_search" model="ir.ui.view">
        <field name="name">lfood.reminder.search</field>
        <field name="model">lfood.reminder</field>
        <field name="arch" type="xml">
            <search>
                <field name="title"/>
                <filter name="open" string="Cần xử lý" domain="[('state', '=', 'open')]"/>
                <filter name="overdue" string="Đã quá hạn" domain="[('state', '=', 'open'), ('due_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="tax" string="Thuế" domain="[('category', '=', 'tax')]"/>
                <filter name="hr" string="Nhân sự" domain="[('category', '=', 'hr')]"/>
                <filter name="stock" string="Kho" domain="[('category', '=', 'stock')]"/>
                <filter name="receivable" string="Công nợ" domain="[('category', '=', 'receivable')]"/>
                <group>
                    <filter name="by_category" string="Nhóm" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_reminder" model="ir.actions.act_window">
        <field name="name">Việc sắp đến hạn</field>
        <field name="res_model">lfood.reminder</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
    <record id="action_reminder_refresh" model="ir.actions.server">
        <field name="name">Quét lại việc sắp đến hạn</field>
        <field name="model_id" ref="model_lfood_reminder"/>
        <field name="binding_model_id" ref="model_lfood_reminder"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">model._cron_refresh()</field>
    </record>
    <record id="cron_reminder_refresh" model="ir.cron">
        <field name="name">LiFeOOD: quét việc sắp đến hạn</field>
        <field name="model_id" ref="model_lfood_reminder"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

    <record id="view_company_form_remind" model="ir.ui.view">
        <field name="name">res.company.lfood.form.remind</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="lfood_base.view_company_lfood_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lfood_edit_after_post_days']" position="after">
                <field name="lfood_remind_days"/>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_reminder" name="Việc sắp đến hạn" parent="lfood_base.menu_root" action="action_reminder" sequence="1"/>
</odoo>
