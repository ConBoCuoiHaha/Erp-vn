<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_privacy_root" name="Dữ liệu cá nhân" parent="lfood_base.menu_control" sequence="60"/>

    <record id="view_consent_list" model="ir.ui.view">
        <field name="name">lfood.privacy.consent.list</field>
        <field name="model">lfood.privacy.consent</field>
        <field name="arch" type="xml">
            <list string="Căn cứ xử lý dữ liệu" decoration-muted="state == 'withdrawn'">
                <field name="subject_name"/>
                <field name="purpose"/>
                <field name="data_types"/>
                <field name="sensitive"/>
                <field name="basis"/>
                <field name="given_on"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_consent_form" model="ir.ui.view">
        <field name="name">lfood.privacy.consent.form</field>
        <field name="model">lfood.privacy.consent</field>
        <field name="arch" type="xml">
            <form string="Căn cứ xử lý dữ liệu">
                <header>
                    <button name="action_withdraw" type="object" string="Ghi nhận rút lại sự đồng ý"
                            invisible="state != 'active' or basis != 'consent'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="subject_kind"/>
                            <field name="employee_id" invisible="subject_kind != 'employee'" options="{'no_create': True}"/>
                            <field name="partner_id" invisible="subject_kind != 'partner'" options="{'no_create': True}"/>
                            <field name="purpose"/>
                            <field name="data_types"/>
                            <field name="sensitive"/>
                        </group>
                        <group>
                            <field name="basis"/>
                            <field name="channel" invisible="basis != 'consent'" required="basis == 'consent'"/>
                            <field name="given_on"/>
                            <field name="evidence" filename="evidence_name"/>
                            <field name="evidence_name" invisible="1"/>
                            <field name="withdrawn_on" invisible="not withdrawn_on"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <div class="text-muted">Sự đồng ý phải rõ ràng, kiểm chứng được thời điểm và nội dung; không đặt sẵn mặc định
                        đồng ý (Nghị định 356/2025/NĐ-CP). Quản lý lao động theo hợp đồng, thực hiện hợp đồng, nghĩa vụ theo luật
                        là căn cứ xử lý không cần sự đồng ý.</div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_consent" model="ir.actions.act_window">
        <field name="name">Căn cứ xử lý, sự đồng ý</field>
        <field name="res_model">lfood.privacy.consent</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_request_list" model="ir.ui.view">
        <field name="name">lfood.privacy.request.list</field>
        <field name="model">lfood.privacy.request</field>
        <field name="arch" type="xml">
            <list string="Yêu cầu của chủ thể dữ liệu" decoration-danger="late" decoration-muted="state in ('done', 'refused')">
                <field name="name"/>
                <field name="received_on"/>
                <field name="subject_name"/>
                <field name="kind"/>
                <field name="respond_by"/>
                <field name="due_date"/>
                <field name="late" column_invisible="1"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_request_form" model="ir.ui.view">
        <field name="name">lfood.privacy.request.form</field>
        <field name="model">lfood.privacy.request</field>
        <field name="arch" type="xml">
            <form string="Yêu cầu của chủ thể dữ liệu">
                <header>
                    <button name="action_respond" type="object" string="Đã phản hồi người yêu cầu" class="btn-primary"
                            invisible="state != 'new'"/>
                    <button name="action_extend" type="object" string="Gia hạn một lần"
                            invisible="extended or state not in ('new', 'responded')"/>
                    <button name="action_done" type="object" string="Đã thực hiện" class="btn-primary"
                            invisible="state != 'responded'"/>
                    <button name="action_refuse" type="object" string="Từ chối có lý do" invisible="state != 'responded'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,responded,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="subject_kind"/>
                            <field name="employee_id" invisible="subject_kind != 'employee'" options="{'no_create': True}"/>
                            <field name="partner_id" invisible="subject_kind != 'partner'" options="{'no_create': True}"/>
                            <field name="subject_name"/>
                            <field name="kind"/>
                            <field name="received_on"/>
                            <field name="third_party"/>
                        </group>
                        <group>
                            <field name="respond_by"/>
                            <field name="due_date"/>
                            <field name="extended"/>
                            <field name="responded_on"/>
                            <field name="done_on"/>
                            <field name="late"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="detail" placeholder="Nội dung yêu cầu"/>
                    <field name="result" placeholder="Kết quả xử lý hoặc lý do từ chối"/>
                    <div class="text-muted">Nghị định 356/2025/NĐ-CP: phản hồi trong 2 ngày làm việc; thực hiện rút đồng ý, hạn chế,
                        phản đối trong 15 ngày (20 ngày nếu cần bên thứ ba), xem, chỉnh sửa, cung cấp trong 10 ngày (15), xóa trong
                        20 ngày (30), biện pháp bảo vệ trong 15 ngày; gia hạn một lần. Sổ kế toán, chứng từ phải lưu theo Luật Kế
                        toán nên yêu cầu xóa có thể bị từ chối một phần, ghi rõ lý do.</div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_request" model="ir.actions.act_window">
        <field name="name">Yêu cầu của chủ thể dữ liệu</field>
        <field name="res_model">lfood.privacy.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_breach_list" model="ir.ui.view">
        <field name="name">lfood.privacy.breach.list</field>
        <field name="model">lfood.privacy.breach</field>
        <field name="arch" type="xml">
            <list string="Sự cố dữ liệu cá nhân">
                <field name="detected_at"/>
                <field name="name"/>
                <field name="subject_count"/>
                <field name="subject_notice_by"/>
                <field name="authority_notified_at"/>
                <field name="fixed_on"/>
            </list>
        </field>
    </record>
    <record id="view_breach_form" model="ir.ui.view">
        <field name="name">lfood.privacy.breach.form</field>
        <field name="model">lfood.privacy.breach</field>
        <field name="arch" type="xml">
            <form string="Sự cố dữ liệu cá nhân">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="detected_at"/>
                            <field name="subject_count"/>
                            <field name="location_biometric"/>
                            <field name="subject_notice_by" invisible="not location_biometric"/>
                        </group>
                        <group>
                            <field name="authority_notified_at"/>
                            <field name="subjects_notified_at"/>
                            <field name="fixed_on"/>
                            <field name="keep_until"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Diễn biến, dữ liệu bị ảnh hưởng"/>
                    <field name="remedy" placeholder="Biện pháp khắc phục"/>
                    <div class="text-muted">Báo cơ quan chuyên trách bảo vệ dữ liệu cá nhân (Cục A05, Bộ Công an); dữ liệu vị trí,
                        sinh trắc học phải báo chủ thể trong 72 giờ hoặc công bố công khai; hồ sơ lưu tối thiểu 5 năm sau khi khắc
                        phục (Nghị định 356/2025/NĐ-CP).</div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_breach" model="ir.actions.act_window">
        <field name="name">Sự cố dữ liệu cá nhân</field>
        <field name="res_model">lfood.privacy.breach</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_view_log" model="ir.actions.act_window">
        <field name="name">Nhật ký mở xem hồ sơ nhân sự, lương</field>
        <field name="res_model">lfood.audit.log</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('action', '=', 'view')]</field>
    </record>

    <record id="view_company_form_privacy" model="ir.ui.view">
        <field name="name">res.company.lfood.form.privacy</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="lfood_base.view_company_lfood_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Bảo vệ dữ liệu cá nhân">
                    <group>
                        <field name="lfood_dpo_name"/>
                        <field name="lfood_dpo_contact"/>
                        <field name="lfood_size"/>
                    </group>
                    <group>
                        <field name="lfood_sensitive_data"/>
                        <field name="lfood_subject_count"/>
                        <field name="lfood_privacy_exempt"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_privacy_consent" name="Căn cứ xử lý, sự đồng ý" parent="menu_privacy_root" action="action_consent" sequence="10"/>
    <menuitem id="menu_privacy_request" name="Yêu cầu của chủ thể dữ liệu" parent="menu_privacy_root" action="action_request" sequence="20"/>
    <menuitem id="menu_privacy_breach" name="Sự cố dữ liệu cá nhân" parent="menu_privacy_root" action="action_breach" sequence="30"
              groups="lfood_base.group_chief_accountant,lfood_base.group_director"/>
    <menuitem id="menu_privacy_views" name="Nhật ký mở xem hồ sơ" parent="menu_privacy_root" action="action_view_log" sequence="40"
              groups="lfood_base.group_chief_accountant,lfood_base.group_director"/>
</odoo>
