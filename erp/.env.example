# Sao chép thành .env rồi điền giá trị thật. Không đưa .env lên git.
# Mật khẩu cơ sở dữ liệu (phải trùng db_password trong config/odoo.conf)
DB_PASSWORD=doi-mat-khau-nay
# Thư mục lưu bản sao trên máy (ngoài thư mục code)
BACKUP_DIR=C:/Users/ADMIN/Desktop/ERP-LiFeOOD-Backup
# Giờ sao lưu mỗi ngày, cách nhau dấu phẩy
BACKUP_TIMES=12:00,17:30
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=12

# Bản sao mã hóa ngoài máy: để trống là TẮT.
# Muốn bật: đặt OFFSITE_DIR và BACKUP_PASSPHRASE (cụm mật khẩu dài). Mất cụm này thì không giải mã được.
OFFSITE_DIR=
BACKUP_PASSPHRASE=
